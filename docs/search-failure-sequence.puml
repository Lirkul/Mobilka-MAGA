@startuml
title Поиск книг при отказах компонентов

autonumber

actor "Пользователь" as U
participant "Мобильное приложение" as App
participant "Балансировщик" as LB
participant "API Gateway\n(2 экземпляра)" as G
participant "Сервис каталога\n(2 экземпляра)" as C
database "Redis" as R
database "PostgreSQL\nосновной" as P
database "PostgreSQL\nрезервный" as B

U -> App : Вводит название книги
App -> LB : GET /api/search

alt Балансировщик недоступен
    note over App, LB
        Ответ от сервера не поступает
    end note
    App -> App : Тайм-аут запроса

else Балансировщик работает

    alt Оба API Gateway недоступны
        LB --> App : Ошибка 503

    else Есть работающий Gateway
        LB -> G : Передать запрос

        alt Оба экземпляра каталога недоступны
            G --> LB : Ошибка 503

        else Есть работающий экземпляр

            opt Один экземпляр каталога отказал
                note over G, C
                    Gateway направляет запрос
                    на работающий экземпляр
                end note
            end

            G -> C : Выполнить поиск
            C -> R : Проверить кеш

            alt Результат найден в Redis
                R --> C : Данные книг

            else Кеш пуст или недоступен
                R --> C : Нет данных / тайм-аут
                C -> P : Поиск книги

                alt Основная БД работает
                    P --> C : Данные книг

                else Основная БД недоступна
                    C -> B : Повторить чтение

                    alt Резервная БД работает
                        B --> C : Данные книг

                    else Резервная БД недоступна
                        note over C, B
                            Получить данные
                            невозможно
                        end note
                    end
                end
            end

            C --> G : Результат 200 или ошибка 503
            G --> LB : Передать ответ

        end

        LB --> App : Передать результат или ошибку
    end
end

App --> U : Показать книги или сообщение об ошибке

note over App, LB
    Ответ позднее 2 секунд
    считается неуспешным
end note
@enduml
